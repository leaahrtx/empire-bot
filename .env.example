# Copie ce fichier en .env puis remplis les valeurs.
# Ne commit JAMAIS le fichier .env.

# Developer Portal > Bot > Reset Token
DISCORD_TOKEN=

# Developer Portal > General Information > Application ID
CLIENT_ID=

# Clic droit sur ton serveur Discord > Copier l'identifiant du serveur
# (nécessite Paramètres > Avancés > Mode développeur)
GUILD_ID=
